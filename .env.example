# ==========================================
# BITGET API CREDENTIALS
# ==========================================
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_API_PASSPHRASE=your_passphrase_here

# Mode simulasi (True: Paper trading tanpa uang asli, False: Live trading)
DRY_RUN=true

# ==========================================
# STRATEGY & CAPITAL ALLOCATION
# ==========================================
# Modal maksimum per posisi pasangan (USDT)
MAX_CAPITAL_PER_POSITION_USDT=100.0

# Total alokasi modal maksimum untuk seluruh bot (USDT)
TOTAL_MAX_CAPITAL_USDT=500.0

# Leverage untuk Kaki Perp Short (Rekomendasi 1x - 3x)
LEVERAGE=2

# Minimal volume 24 jam Spot & Futures (USDT) untuk filter likuiditas
MIN_24H_VOLUME_USDT=1000000.0

# ==========================================
# FEE & PROFITABILITY CRITERIA
# ==========================================
# Tingkat Fee Bitget (VIP0 Spot Taker: 0.001 (0.1%), Perp Taker: 0.0006 (0.06%))
# Gunakan nilai yang sesuai dengan tier VIP akun Anda
SPOT_TAKER_FEE=0.001
SPOT_MAKER_FEE=0.001
PERP_TAKER_FEE=0.0006
PERP_MAKER_FEE=0.0002

# Buffer slippage yang diantisipasi (misal 0.0005 = 0.05%)
SLIPPAGE_BUFFER=0.0005

# Syarat minimal Net APY setelah dikurangi semua fee (%)
MIN_NET_APY_PERCENT=15.0

# Batas maksimal jam impas (break-even hours) yang ditoleransi
MAX_BREAK_EVEN_HOURS=72.0

# Minimal konsistensi funding rate positif (misal minimal 3 siklus berturut-turut)
MIN_CONSECUTIVE_POSITIVE_FUNDING=2

# ==========================================
# RISK MANAGEMENT & AUTO-EXIT
# ==========================================
# Ambang batas margin ratio futures (peringatan jika margin ratio mendekati batas ini)
MARGIN_CALL_THRESHOLD=0.75

# Tutup posisi darurat jika funding rate berubah menjadi negatif di bawah nilai ini (-0.0001 = -0.01%)
EMERGENCY_EXIT_FUNDING_RATE=-0.0001

# Tutup posisi jika funding rate turun di bawah ambang ini selama N siklus
EXIT_NEGATIVE_CYCLES_COUNT=1

# ==========================================
# TELEGRAM NOTIFICATIONS (OPSIONAL)
# ==========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
